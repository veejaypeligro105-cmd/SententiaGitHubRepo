; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sententia = Demo V11.14(Test Enemy, No Xp drops yet,New Art Implementation)"
run/main_scene="uid://cluam0pdalexj"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

DialogueManager="*uid://c3rodes2l3gxb"
SceneManager="*uid://kxg5wfmsjjfl"
SceneRegistry="*uid://02gapwjy3o4v"
Database="*uid://d3ejn5or2x2ib"
Session="*uid://c12tubgp3qvqp"
Inventory="*uid://dffwrhhia7mwm"
HealthManager="*uid://dxq1i7ff6bfsf"
GameManager="*uid://q5n341d8ht0"
PlayerStats="*uid://d2x6ki0xyekf8"
QuestManager="*uid://dnnvevirlmq7r"
InventoryUI="*uid://dvbtdkb6bd7ls"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"

[editor_plugins]

enabled=PackedStringArray("res://addons/aseprite_spritesheet_importer/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/godot-sqlite/plugin.cfg", "res://addons/tile_to_gridmap/plugin.cfg")

