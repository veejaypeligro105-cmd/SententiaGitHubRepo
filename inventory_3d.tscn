[gd_scene format=3 uid="uid://71a1vko8a125"]

[sub_resource type="GDScript" id="GDScript_crvhe"]
script/source = "extends Control

@onready var item_list = $Panel/ItemList
@onready var description_label = $Panel/DescriptionPanel/Descriptionlabel
@onready var usebtn = $Panel/Use
@onready var closebtn = $Panel/Close

var selected_item = null

signal inventory_closed

func _ready() -> void:
	Inventory.inventory_changed.connect(update_ui)
	usebtn.pressed.connect(_on_use_pressed)
	closebtn.pressed.connect(_on_close_pressed)

	update_ui()
	hide()

func update_ui():
	for child in item_list.get_children():
		child.queue_free()

	for id in Inventory.get_items():
		var data = Inventory.items[id]
		var item = data[\"item\"]
		var qty = data[\"quantity\"]

		var btn = Button.new()
		btn.text = \"%s x%d\" % [item.item_name, qty]

		btn.pressed.connect(func():
			select_item(item)
		)

		item_list.add_child(btn)

func select_item(item):
	selected_item = item
	description_label.text = item.description

func _on_use_pressed() -> void:
	if selected_item == null:
		return

	print(\"Using item: \", selected_item.item_name)

	# USE RESOURCE FUNCTION
	selected_item.use()

	# Remove if consumable
	if selected_item.item_type == \"consumable\":
		Inventory.remove_item(selected_item)

	elif selected_item.item_type == \"key\":
		print(\"Key item kept.\")

	selected_item = null
	description_label.text = \"\"

func _on_close_pressed():
	hide()
	emit_signal(\"inventory_closed\")
"

